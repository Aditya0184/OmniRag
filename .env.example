# Run commands from the repository root. All settings use the OMNIRAG_ prefix.
OMNIRAG_DATA_DIR=./data/local
OMNIRAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
OMNIRAG_OLLAMA_MODEL=qwen3-vl:2b-instruct
# grounded = written answers with validated citations (default);
# extractive = verbatim selected excerpts only (Phase 5-11 behavior).
OMNIRAG_ANSWER_MODE=grounded
OMNIRAG_RETRIEVAL_ENABLED=true
OMNIRAG_DEFAULT_RETRIEVAL_MODE=hybrid_rerank
OMNIRAG_RETRIEVAL_MODELS_DIR=./data/models
OMNIRAG_RETRIEVAL_MANIFEST=./models/retrieval.lock.json
OMNIRAG_RETRIEVAL_CANDIDATES=12
OMNIRAG_RETRIEVAL_THREADS=2
OMNIRAG_MODEL_TIMEOUT_SECONDS=120
OMNIRAG_CONTEXT_TOKENS=4096
OMNIRAG_MAX_OUTPUT_TOKENS=768
OMNIRAG_TOP_K=4
OMNIRAG_UPLOAD_MAX_MB=10
OMNIRAG_MAX_PAGES=100
OMNIRAG_INGEST_TIMEOUT_SECONDS=90
OMNIRAG_OCR_ENABLED=true
OMNIRAG_OCR_MAX_PAGES=20
OMNIRAG_OCR_PAGE_TIMEOUT_SECONDS=20
# Development defaults. scripts/mac_app.py overrides both to true for the private Mac app.
OMNIRAG_AUTH_ENABLED=false
OMNIRAG_SERVE_FRONTEND=false
OMNIRAG_FRONTEND_DIST=./frontend/dist
# Keep API/UI bound to 127.0.0.1. This is not a public-hosting configuration.
# No cloud API keys are used.
